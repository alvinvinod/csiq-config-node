{
  "name": "@csiq/config-node",
  "version": "0.1.0",
  "description": "gRPC client for CareStack Configuration. Depend on IConfigurationClient.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "proto"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/**/*.test.ts",
    "poc:circuit-breaker": "node scripts/poc-circuit-breaker.js",
    "smoke": "npm run build && node scripts/smoke.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "cockatiel": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "registry": "https://nexus.infra.aws.carestack.com/repository/carestacknpm/"
  }
}
